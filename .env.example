# Every environment variable the code reads, with fake example values.
# Copy this file to .env for local use (and load it with your process manager or `node --env-file`).
# Never commit the real .env file.

# --- tabletop-server (packages/tabletop-server) ---

# Port to listen on (plain http/ws; put a TLS proxy in front for production).
PORT=3000

# Where rooms are saved: file | sqlite | postgres | memory (memory loses everything on restart).
STORAGE=file

# Directory for STORAGE=file (one JSON file per room) and STORAGE=sqlite (rooms.sqlite).
DATA_DIR=./data

# Connection string for STORAGE=postgres. Fake example, replace with your own.
DATABASE_URL=postgres://tabletop:change-me@localhost:5432/tabletop

# Milliseconds to wait after the last change before saving a room.
SAVE_DEBOUNCE_MS=3000

# debug | info | warn | error | silent
LOG_LEVEL=info
