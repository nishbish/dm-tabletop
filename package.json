{
  "name": "dm-tabletop",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Open-source tabletop and initiative tracker for tabletop RPG sessions.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "npm run demo -w @dm-tabletop/tabletop-client",
    "e2e": "npm run e2e -w @dm-tabletop/tabletop-client && npm run e2e -w @dm-tabletop/initiative-tracker",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
